{
  "name": "dutchenglishautomation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright and API automation for the Dutch-English Phrase Game",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test",
    "test:api": "python3.10 -m pytest tests/api -v",
